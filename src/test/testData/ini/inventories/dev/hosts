# INI-format inventory. The YAML fixture has none, so this covers
# [group:vars], [group:children] and inline host vars.

[webservers]
dev-web-1 app_port=7050 ansible_connection=local
dev-web-2 ansible_connection=local

[webservers:vars]
app_port=7030
app_log_level=info

[platform:children]
webservers

[platform:vars]
app_port=7020

[all:vars]
app_env=dev
app_port=7010
